DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Empty for now; for Qwen3.8 Max once the license is approved
QWEN_API_KEY=
VISION_MODEL=deepseek-v4-flash-vision-exp
AGENT_MODEL=deepseek-v4-pro
RECIPE_MODEL=deepseek-v4-flash
# Crops per photo for recognition: 1, 2 or 4 (set to the best value in T1.4)
VISION_TILES=1
DB_PATH=data/app.db
UNCERTAIN_THRESHOLD=0.6
LOG_LEVEL=INFO
# Optional: enables Logfire instrumentation
LOGFIRE_TOKEN=
