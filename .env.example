DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Empty for now; for Qwen3.8 Max once the license is approved
QWEN_API_KEY=
# Verified 2026-10-12 against api.deepseek.com/models: deepseek-flash (V4.1-Flash, accepts images)
# and deepseek-v4-pro (text only). The old IDs deepseek-v4-flash and deepseek-v4-flash-vision-exp
# are retired aliases that DeepSeek serves with deepseek-flash.
VISION_MODEL=deepseek-flash
AGENT_MODEL=deepseek-v4-pro
RECIPE_MODEL=deepseek-flash
# Crops per photo for recognition: 1, 2 or 4 (set to the best value in T1.4)
VISION_TILES=1
# DeepSeek V4 models think by default. Off for both (decided 2026-10-13): same tool choices, each
# agent call 1-2 s faster, recipe generation 3-4x faster. Set to "on" to compare.
AGENT_THINKING=off
RECIPE_THINKING=off
DB_PATH=data/app.db
UNCERTAIN_THRESHOLD=0.6
LOG_LEVEL=INFO
# Optional: enables Logfire instrumentation
LOGFIRE_TOKEN=
# Optional: dish photos on the meal cards from Pixabay (free key at pixabay.com/api/docs).
# Empty: photos come from Wikimedia Commons (no key, fewer good matches).
PIXABAY_API_KEY=
